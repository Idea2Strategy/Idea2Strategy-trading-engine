# Inject these two blank values from Secrets Manager at runtime. Never commit their values.
ALPACA_API_KEY=
ALPACA_API_SECRET=

MARKET_GATEWAY_REDIS_URI=rediss://cache.internal:6379
MARKET_GATEWAY_REDIS_KEY_PREFIX=i2s
MARKET_GATEWAY_INSTRUMENT_MAPPING_PATH=/run/idea2strategy/market-gateway/instruments.json
MARKET_GATEWAY_RIGHTS_EVIDENCE_PATH=/run/idea2strategy/market-gateway/alpaca-sip-rights.json
MARKET_GATEWAY_MATERIALIZATION_RECEIPT_PATH=/run/idea2strategy/market-gateway/materialization.properties
MARKET_GATEWAY_ALPACA_ENDPOINT=wss://stream.data.alpaca.markets/v2/sip
MARKET_GATEWAY_RECONNECT_INITIAL_DELAY=PT1S
MARKET_GATEWAY_RECONNECT_MAX_DELAY=PT1M
I2S_READINESS_FILE=/tmp/idea2strategy-ready
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
