# Inject these blank values from Secrets Manager at runtime. Never commit their values.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.internal:5432/idea2strategy?sslmode=require
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=false
TRADING_MARKET_EVENTS_REDIS_URI=rediss://cache.internal:6379
TRADING_MARKET_EVENTS_REDIS_KEY_PREFIX=i2s
TRADING_MARKET_EVENTS_CONSUMER_NAME=trading-worker-development-1
TRADING_MARKET_EVENTS_BATCH_SIZE=128
TRADING_MARKET_EVENTS_RECLAIM_AFTER=PT60S
TRADING_MARKET_EVENTS_MAXIMUM_ENTRY_LAG=600
TRADING_MARKET_EVENTS_MAXIMUM_AVAILABILITY_AGE=PT2M
TRADING_MARKET_EVENTS_POLL_DELAY=PT0.2S
TRADING_WARMUP_BUNDLE_ROOT=/run/idea2strategy/trading-worker/warmup
TRADING_WARMUP_MANIFEST_KEY=manifest.json
TRADING_BOT_CONTROL_WORKER_ID=trading-worker-development-1
TRADING_BOT_CONTROL_BATCH_SIZE=32
TRADING_BOT_CONTROL_LEASE=PT30S
TRADING_BOT_CONTROL_RETRY_BACKOFF=PT30S
TRADING_BOT_CONTROL_MAX_ATTEMPTS=5
TRADING_BOT_CONTROL_POLL_DELAY=PT1S
TRADING_RUNTIME_LIFECYCLE_ENABLED=true
TRADING_RUNTIME_SHUTDOWN_DRAIN_TIMEOUT=PT30S
I2S_READINESS_FILE=/tmp/idea2strategy-ready
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

